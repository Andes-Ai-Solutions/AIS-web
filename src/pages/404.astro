---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import AndesBackground from '../components/AndesBackground.astro';
import Button from '../components/Button.astro';
import Logo from '../components/Logo.astro';
import { site, diagnosticoWhatsapp } from '../data/site';
---

<Layout title={`Página no encontrada | ${site.name}`} noindex>
  <main id="contenido" tabindex="-1" class="relative isolate flex min-h-[100svh] items-center justify-center overflow-hidden bg-andes-950 px-4">
    <AndesBackground class="absolute inset-0 -z-20" horizon={0.72} />
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_50%_at_50%_45%,rgb(6_18_29/0.85),transparent_75%)]"
    >
    </div>

    <div class="relative py-16 pb-40 text-center">
      <a href="/" class="inline-flex items-center gap-2" aria-label={`Ir al inicio de ${site.name}`}>
        <Logo class="h-9 w-9" />
        <span class="text-lg font-bold text-white">Andes<span class="text-turq">Ai</span>Solutions</span>
      </a>

      <p class="mt-10 text-sm font-semibold tracking-wider text-turq-400 uppercase">Error 404</p>
      <h1 class="mx-auto mt-3 max-w-xl text-4xl font-extrabold tracking-tight text-balance text-white sm:text-6xl">
        Parece que te perdiste en la montaña
      </h1>
      <p class="mx-auto mt-5 max-w-md text-lg text-slate-200">
        La página que buscas no existe o cambió de lugar. Vuelve al inicio y retomamos desde ahí.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href="/">
          <Icon name="heroicons:home" class="h-5 w-5" />
          Volver al inicio
        </Button>
        <Button href={diagnosticoWhatsapp} variant="ghost" external>Agendar diagnóstico gratis</Button>
      </div>
    </div>
  </main>
</Layout>
