---
import { Icon } from 'astro-icon/components';
import Button from './Button.astro';
import NewTab from './NewTab.astro';
import Topo from './Topo.astro';
import { site, diagnosticoWhatsapp } from '../data/site';

const tile =
  'flex min-h-16 items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-5 py-4 text-white transition hover:border-turq/40 hover:bg-white/10';
---

<section id="contacto" class="px-4 py-24 sm:px-6 sm:py-32">
  <div
    data-reveal
    class="relative isolate mx-auto max-w-5xl overflow-hidden rounded-[2.5rem] border border-white/10 bg-linear-to-b from-andes to-andes-950 px-6 py-16 text-center sm:px-12 sm:py-20"
  >
    <Topo class="absolute -bottom-72 left-1/2 -z-10 h-[52rem] w-[52rem] -translate-x-1/2 text-turq/10" seed={6} />
    <div
      class="pointer-events-none absolute -top-32 left-1/2 -z-10 h-72 w-[36rem] -translate-x-1/2 rounded-full bg-turq/25 blur-3xl"
    >
    </div>

    <h2 class="text-3xl font-bold tracking-tight text-balance text-white sm:text-5xl">Hablemos de tu negocio</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-pretty text-slate-300">
      Agenda un diagnóstico gratis de 30 minutos. Sin compromiso: te cuento qué se puede mejorar y cómo.
    </p>

    <Button href={diagnosticoWhatsapp} external class="mt-10">
      <Icon name="heroicons:calendar-days" class="h-5 w-5" />
      Quiero mi diagnóstico gratis
    </Button>

    <div class="mx-auto mt-12 grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-2">
      <button
        type="button"
        data-copy-email={site.email}
        aria-label={`Copiar correo ${site.email}`}
        class:list={[tile, 'group cursor-pointer sm:col-span-2']}
      >
        <Icon name="heroicons:envelope" class="h-6 w-6 shrink-0 text-turq-400" />
        <span class="min-w-0 truncate text-sm sm:text-base">{site.email}</span>
        <span
          class="ml-1 inline-flex shrink-0 items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-xs font-semibold text-slate-200 transition group-hover:bg-turq group-hover:text-andes-950"
        >
          <Icon name="heroicons:clipboard-document" class="copy-idle h-4 w-4" />
          <Icon name="heroicons:check" class="copy-done hidden h-4 w-4" />
          <span class="copy-label" aria-live="polite">Copiar</span>
        </span>
      </button>
      <a href={site.linkedin} target="_blank" rel="noopener" class={tile}>
        <Icon name="heroicons:link" class="h-6 w-6 text-turq-400" />
        <span>LinkedIn<NewTab /></span>
      </a>
      <a href={site.instagram} target="_blank" rel="noopener" class={tile}>
        <Icon name="heroicons:camera" class="h-6 w-6 text-turq-400" />
        <span>Instagram<NewTab /></span>
      </a>
    </div>
  </div>
</section>
