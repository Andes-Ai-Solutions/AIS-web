---
import { Icon } from 'astro-icon/components';
import { site, diagnosticoWhatsapp } from '../data/site';
---

<section id="contacto" class="relative overflow-hidden bg-andes py-20 sm:py-28">
  <div class="pointer-events-none absolute -bottom-40 -left-20 h-96 w-96 rounded-full bg-turq/20 blur-3xl">
  </div>
  <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6">
    <h2 class="text-3xl font-bold text-white sm:text-4xl">Hablemos de tu negocio</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-slate-200">
      Agenda un diagnóstico gratis de 30 minutos. Sin compromiso: te cuento qué se puede mejorar y
      cómo.
    </p>

    <a
      href={diagnosticoWhatsapp}
      target="_blank"
      rel="noopener"
      class="mt-10 inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-turq px-8 py-4 font-semibold text-andes shadow-lg shadow-turq/20 transition hover:bg-turq-400"
    >
      <Icon name="heroicons:calendar-days" class="h-5 w-5" />
      Quiero mi diagnóstico gratis
    </a>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      <button
        type="button"
        data-copy-email={site.email}
        aria-label={`Copiar correo ${site.email}`}
        class="group flex min-h-16 sm:col-span-2 cursor-pointer items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-5 py-4 text-white transition hover:bg-white/10"
      >
        <Icon name="heroicons:envelope" class="h-6 w-6 shrink-0 text-turq" />
        <span class="min-w-0 truncate text-sm sm:text-base">{site.email}</span>
        <span
          class="ml-1 inline-flex shrink-0 items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-xs font-semibold text-slate-200 transition group-hover:bg-turq group-hover:text-andes"
        >
          <Icon name="heroicons:clipboard-document" class="copy-idle h-4 w-4" />
          <Icon name="heroicons:check" class="copy-done hidden h-4 w-4" />
          <span class="copy-label" aria-live="polite">Copiar</span>
        </span>
      </button>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener"
        class="flex min-h-16 items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-6 py-4 text-white transition hover:bg-white/10"
      >
        <Icon name="heroicons:link" class="h-6 w-6 text-turq" />
        <span>LinkedIn</span>
      </a>
      <a
        href={site.instagram}
        target="_blank"
        rel="noopener"
        class="flex min-h-16 items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-6 py-4 text-white transition hover:bg-white/10"
      >
        <Icon name="heroicons:camera" class="h-6 w-6 text-turq" />
        <span>Instagram</span>
      </a>
    </div>
  </div>
</section>
