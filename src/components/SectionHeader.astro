---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center" data-reveal>
  <p class="inline-flex items-center gap-3 text-sm font-semibold tracking-[0.2em] text-turq-400 uppercase">
    <span class="h-px w-8 bg-linear-to-r from-transparent to-turq-400" aria-hidden="true"></span>
    {eyebrow}
    <span class="h-px w-8 bg-linear-to-l from-transparent to-turq-400" aria-hidden="true"></span>
  </p>
  <h2 class="mt-4 text-3xl font-bold tracking-tight text-balance text-white sm:text-5xl">{title}</h2>
  {description && <p class="mt-5 text-lg text-pretty text-slate-400">{description}</p>}
</div>
