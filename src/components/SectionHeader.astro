---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center">
  <p class="text-sm font-semibold tracking-wider text-turq-600 uppercase">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-bold text-andes sm:text-4xl">{title}</h2>
</div>
