---
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import { services } from '../data/site';
---

<section id="servicios" class="bg-slate-50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader eyebrow="Servicios" title="Tecnología hecha a la medida de tu negocio" />

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        services.map((s) => (
          <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-md">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-andes text-turq">
              <Icon name={s.icon} class="h-6 w-6" />
            </div>
            <h3 class="mt-5 text-xl font-semibold text-andes">{s.title}</h3>
            <p class="mt-2 leading-relaxed">{s.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
