---
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import { steps } from '../data/site';

// Perfil de montaña (coordenadas en %) que pasa por los cuatro pasos: el último es la cumbre.
const nodes = [
  { x: 12.5, y: 78 },
  { x: 37.5, y: 58 },
  { x: 62.5, y: 38 },
  { x: 87.5, y: 14 },
];
const ridge = 'M0,96 L6,88 L12.5,78 L20,84 L28,70 L37.5,58 L45,66 L53,50 L62.5,38 L70,46 L79,28 L87.5,14 L94,24 L100,20';
---

<section id="proceso" class="relative isolate overflow-hidden bg-andes-900 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader
      eyebrow="Cómo trabajo"
      title="Un proceso claro, sin sorpresas"
      description="Del diagnóstico a tu solución funcionando, paso a paso."
    />

    <!-- Ruta hacia la cumbre (solo en pantallas medianas en adelante) -->
    <div data-reveal class="relative mt-20 hidden h-40 md:block" aria-hidden="true">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="absolute inset-0 h-full w-full overflow-visible">
        <defs>
          <linearGradient id="trail-stroke" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#34608a"></stop>
            <stop offset="1" stop-color="#00b4a6"></stop>
          </linearGradient>
          <linearGradient id="trail-fill" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="#00b4a6" stop-opacity="0.16"></stop>
            <stop offset="1" stop-color="#00b4a6" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <path d={`${ridge} L100,100 L0,100 Z`} fill="url(#trail-fill)"></path>
        <path
          class="trail-draw"
          d={ridge}
          pathLength="1"
          fill="none"
          stroke="url(#trail-stroke)"
          stroke-width="2"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"></path>
      </svg>
      {
        nodes.map((node, i) => (
          <div
            class="absolute -translate-x-1/2 -translate-y-1/2"
            style={`left: ${node.x}%; top: ${node.y}%`}
          >
            {i === nodes.length - 1 ? (
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-turq text-andes-950 shadow-[0_0_30px_-4px_rgb(0_180_166/0.9)] ring-4 ring-andes-900">
                <Icon name="heroicons:flag" class="h-5 w-5" />
              </div>
            ) : (
              <div class="h-4 w-4 rounded-full bg-turq shadow-[0_0_16px_rgb(0_180_166/0.8)] ring-4 ring-andes-900" />
            )}
          </div>
        ))
      }
    </div>

    <ol
      class="relative mt-14 space-y-10 border-l border-white/10 pl-8 md:mt-8 md:grid md:grid-cols-4 md:gap-6 md:space-y-0 md:border-0 md:pl-0"
    >
      {
        steps.map((step, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 120}ms`} class="relative md:text-center">
            <span
              class="absolute top-1 -left-[2.4rem] h-3 w-3 rounded-full bg-turq ring-4 ring-andes-900 md:hidden"
              aria-hidden="true"
            />
            <p class="text-xs font-semibold tracking-[0.2em] text-turq-400 uppercase">Paso {i + 1}</p>
            <h3 class="mt-2 text-lg font-semibold text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
