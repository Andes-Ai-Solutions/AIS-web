---
import SectionHeader from './SectionHeader.astro';
import { steps } from '../data/site';
---

<section id="proceso" class="bg-slate-50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader eyebrow="Cómo trabajo" title="Un proceso claro, sin sorpresas" />

    <div class="relative mt-14">
      <div
        class="absolute top-6 right-0 left-0 hidden h-0.5 bg-linear-to-r from-turq/0 via-turq/40 to-turq/0 md:block"
      >
      </div>
      <ol class="relative grid gap-10 md:grid-cols-4 md:gap-6">
        {
          steps.map((step, i) => (
            <li class="text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-turq text-lg font-bold text-andes ring-8 ring-slate-50">
                {i + 1}
              </div>
              <h3 class="mt-5 font-semibold text-andes">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
