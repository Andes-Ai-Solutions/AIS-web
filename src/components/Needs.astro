---
import { Icon } from 'astro-icon/components';
import Card from './Card.astro';
import NewTab from './NewTab.astro';
import SectionHeader from './SectionHeader.astro';
import { needs, site, whatsappLink } from '../data/site';
---

<section id="que-necesitas" class="py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader
      eyebrow="¿Qué necesitas?"
      title="Cuéntame qué buscas y hablemos"
      description="Elige una opción y se abre WhatsApp con el mensaje listo para enviar."
    />

    <!-- flex-wrap centrado: si la última fila queda incompleta, sus tarjetas quedan al centro -->
    <div class="mt-16 flex flex-wrap justify-center gap-5">
      {
        needs.map((need, i) => (
          <div
            data-reveal
            style={`--reveal-delay: ${(i % 3) * 90}ms`}
            class="w-full sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.834rem)]"
          >
            <Card as="a" href={whatsappLink(need.message)} target="_blank" rel="noopener" class="flex flex-col p-7">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-turq/10 text-turq-400 ring-1 ring-turq/25 transition duration-300 group-hover:bg-turq group-hover:text-andes-950">
                <Icon name={need.icon} class="h-6 w-6" />
              </div>
              <h3 class="mt-6 text-lg font-semibold text-white">{need.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{need.description}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-turq-400">
                <Icon name="heroicons:chat-bubble-oval-left-ellipsis" class="h-5 w-5" />
                Escribir por WhatsApp
                <Icon
                  name="heroicons:arrow-up-right"
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </span>
              <span class="sr-only"> sobre {need.title}</span>
              <NewTab />
            </Card>
          </div>
        ))
      }
    </div>

    <!-- Para quien prefiere el correo (sirve con Gmail, Outlook o lo que use el cliente) -->
    <div
      data-reveal
      class="mx-auto mt-10 flex max-w-xl flex-col items-center justify-center gap-3 text-sm text-slate-400 sm:flex-row"
    >
      <span>¿Prefieres el correo?</span>
      <button
        type="button"
        data-copy-email={site.email}
        aria-label={`Copiar correo ${site.email}`}
        class="group inline-flex min-h-11 max-w-full cursor-pointer items-center gap-2 rounded-full border border-white/10 bg-white/5 py-1.5 pr-1.5 pl-4 text-white transition hover:border-turq/40"
      >
        <Icon name="heroicons:envelope" class="h-4 w-4 shrink-0 text-turq-400" />
        <span class="min-w-0 truncate">{site.email}</span>
        <span
          class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-xs font-semibold text-slate-200 transition group-hover:bg-turq group-hover:text-andes-950"
        >
          <Icon name="heroicons:clipboard-document" class="copy-idle h-4 w-4" />
          <Icon name="heroicons:check" class="copy-done hidden h-4 w-4" />
          <span class="copy-label" aria-live="polite">Copiar</span>
        </span>
      </button>
    </div>
  </div>
</section>
