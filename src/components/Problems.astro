---
import { Icon } from 'astro-icon/components';
import Card from './Card.astro';
import SectionHeader from './SectionHeader.astro';
import Topo from './Topo.astro';
import { problems } from '../data/site';
---

<section id="problemas" class="relative isolate overflow-hidden py-24 sm:py-32">
  <Topo class="absolute -top-40 -right-56 -z-10 h-[44rem] w-[44rem] text-turq/[0.07]" seed={2} />

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader eyebrow="¿Te suena familiar?" title="¿Sigues llevando tu negocio en Excel y WhatsApp?" />

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        problems.map((p, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <Card class="p-6">
              <div class="flex items-start justify-between">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-turq/10 text-turq-400 ring-1 ring-turq/25 transition duration-300 group-hover:scale-110 group-hover:bg-turq/20">
                  <Icon name={p.icon} class="h-6 w-6" />
                </div>
                <span class="text-3xl font-extrabold text-white/10" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="mt-6 text-lg font-semibold text-white">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-400">{p.description}</p>
            </Card>
          </div>
        ))
      }
    </div>

    <p data-reveal class="mt-14 text-center text-lg text-slate-300">
      No tiene que ser así.{' '}
      <a
        href="#servicios"
        class="group inline-flex items-center gap-1 font-semibold text-turq-400 transition hover:text-turq"
      >
        Hay una forma más simple
        <Icon name="heroicons:arrow-down" class="h-4 w-4 transition-transform group-hover:translate-y-0.5" />
      </a>
    </p>
  </div>
</section>
